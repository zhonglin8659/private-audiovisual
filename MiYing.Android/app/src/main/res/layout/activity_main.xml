<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/screen_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_mobile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/title_home"
                android:textSize="15sp"
                android:textColor="@color/text_sub" />

            <Button
                android:id="@+id/btn_open_video"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/btn_primary"
                android:text="@string/btn_open_video"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_open_photo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_secondary_button"
                android:text="@string/btn_open_photo"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:stateListAnimator="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recent"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_clear_recent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="6dp"
                    android:text="清空"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/list_recent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/text_no_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/no_recent"
                android:textColor="@color/text_sub" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/screen_unlock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/btn_unlock_back"
                    android:background="@android:color/transparent"
                    android:focusable="false"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/text"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="解锁媒体"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_unlock_card"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center_horizontal"
                            android:contentDescription="加密媒体"
                            android:src="@drawable/ic_lock" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="输入访问密码"
                            android:textColor="@color/text"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_unlock_file"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="middle"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textColor="@color/text_sub"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="密码仅用于本机内存解密，不会保存"
                            android:textColor="@color/text_sub"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/input_password"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="@string/hint_password"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/text"
                            android:textColorHint="@color/text_sub"
                            android:textSize="15sp" />

                        <CheckBox
                            android:id="@+id/check_remember"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:buttonTint="@color/accent"
                            android:text="@string/remember_password"
                            android:textColor="@color/text_sub"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btn_unlock"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/btn_primary"
                            android:stateListAnimator="@null"
                            android:text="@string/btn_unlock"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/text_unlock_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:textColor="@color/danger"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/progress_unlock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/screen_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#FF000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:surface_type="texture_view" />

        <View
            android:id="@+id/video_touch_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent" />

        <LinearLayout
            android:id="@+id/video_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_fade"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/btn_video_back"
                android:background="@android:color/transparent"
                android:focusable="false"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/text"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/text_video_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F2FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/video_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_fade"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <SeekBar
                android:id="@+id/seek_video"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/seekbar_style"
                android:splitTrack="false"
                android:thumbTint="@color/accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_video_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="00:00 / 00:00"
                    android:textColor="#B8FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_speed"
                    style="@style/VideoChipButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="1.0x" />

                <Button
                    android:id="@+id/btn_mute"
                    style="@style/VideoChipButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/video_mute" />

                <Button
                    android:id="@+id/btn_video_fullscreen"
                    style="@style/VideoChipButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="横屏" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_back10"
                    style="@style/VideoControlButton"
                    android:layout_width="68dp"
                    android:text="-10s" />

                <Button
                    android:id="@+id/btn_play"
                    style="@style/VideoPlayButton"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:text="▶" />

                <Button
                    android:id="@+id/btn_forward10"
                    style="@style/VideoControlButton"
                    android:layout_width="68dp"
                    android:text="+10s" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/screen_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/bg">

        <com.miying.player.ui.PhotoZoomView
            android:id="@+id/photo_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/photo_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_fade"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/btn_photo_back"
                android:layout_gravity="center_vertical"
                android:background="@android:color/transparent"
                android:focusable="false"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textSize="34sp"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/text_photo_name"
                android:layout_gravity="center_vertical"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="44dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/photo_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_bottom_fade"
            android:paddingStart="16dp"
            android:paddingTop="38dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/text_photo_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/text_sub" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_photo_fit"
                    style="@style/VideoChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/photo_fit" />

                <Button
                    android:id="@+id/btn_photo_100"
                    style="@style/VideoChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/photo_100" />

                <Button
                    android:id="@+id/btn_photo_zoom_out"
                    style="@style/VideoChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/photo_zoom_out" />

                <Button
                    android:id="@+id/btn_photo_zoom_in"
                    style="@style/VideoChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/photo_zoom_in" />

                <Button
                    android:id="@+id/btn_photo_rotate"
                    style="@style/VideoChipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/photo_rotate" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>