<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MiYing" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
        <item name="android:colorControlNormal">@color/text_sub</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="VideoControlButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:background">@drawable/bg_control_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="VideoPlayButton" parent="VideoControlButton">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/bg_play_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="VideoChipButton" parent="VideoControlButton">
        <item name="android:layout_height">38dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_control_chip</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_sub</item>
    </style>

    <style name="SecondaryButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>
</resources>