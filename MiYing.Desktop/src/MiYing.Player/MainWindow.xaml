<ui:FluentWindow
    x:Class="MiYing.Player.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:conv="clr-namespace:MiYing.Player.Converters"
    xmlns:myui="clr-namespace:MiYing.UI;assembly=MiYing.UI"
    Title="{Binding WindowTitle}"
    Width="1280" Height="800"
    MinWidth="920" MinHeight="580"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    Topmost="{Binding IsTopmost}"
    AllowDrop="True"
    DragOver="OnWindowDragOver"
    Drop="OnWindowDrop"
    Closing="OnWindowClosing"
    Loaded="OnWindowLoaded"
    PreviewKeyDown="OnWindowPreviewKeyDown"
    PreviewMouseMove="OnWindowPreviewMouseMove">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:TimeMsConverter x:Key="TimeMs" />
        <conv:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
        <conv:PlayPauseIconConverter x:Key="PlayPauseIcon" />
        <conv:EndedIconConverter x:Key="EndedIcon" />
        <conv:VolumeIconConverter x:Key="VolumeIcon" />
        <conv:RecentIconConverter x:Key="RecentIcon" />
        <conv:MediaIconConverter x:Key="MediaIcon" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Grid x:Name="TitleBarHost" Grid.Row="0">
            <ui:TitleBar Title="{Binding WindowTitle}" ShowMaximize="True" ShowMinimize="True" />
        </Grid>

        <Grid Grid.Row="1">

            <!--  ============ 首页 ============  -->
            <Grid Margin="40,10,40,26" Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <ui:SymbolIcon Symbol="PlayCircle24" FontSize="50" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="密影播放器" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock
                        Text="打开 .msv / .msp 加密文件，支持多选建立本次列表；输入密码后安全观看视频或查看照片（全程内存解密，不产生明文文件）"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        Margin="0,7,0,22"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Content="打开文件（可多选）" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Padding="22,10" Command="{Binding OpenFileCommand}" />
                        <ui:Button Content="添加文件" Icon="{ui:SymbolIcon Add24}" Margin="10,0,0,0" Padding="18,10" Command="{Binding AddFilesCommand}" />
                        <ui:Button Content="设置" Icon="{ui:SymbolIcon Settings24}" Margin="10,0,0,0" Padding="18,10" Command="{Binding ToggleSettingsCommand}" />
                    </StackPanel>
                    <ui:InfoBar
                        Margin="0,20,0,0"
                        Title="无法打开文件"
                        Message="{Binding HomeError}"
                        Severity="Error"
                        IsOpen="{Binding IsHomeErrorVisible, Mode=TwoWay}"
                        IsClosable="True" />
                </StackPanel>

                <!--  本次列表  -->
                <Border
                    Grid.Row="1"
                    Margin="0,26,0,0"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding HasPlaylist, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="20,15,12,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="本次列表" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding PlaylistSummary}"
                                    FontSize="12"
                                    Margin="10,0,0,0"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock
                                    Text="双击卡片播放 / 查看"
                                    FontSize="12"
                                    Margin="14,0,0,0"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ui:Button
                                HorizontalAlignment="Right"
                                Content="清空列表"
                                Icon="{ui:SymbolIcon Broom24}"
                                Appearance="Transparent"
                                Command="{Binding ClearPlaylistCommand}" />
                        </Grid>
                        <ListBox
                            x:Name="PlaylistList"
                            Grid.Row="1"
                            ItemsSource="{Binding Playlist}"
                            Margin="14,0,14,14"
                            Height="238"
                            BorderThickness="0"
                            Background="Transparent"
                            MouseDoubleClick="OnPlaylistDoubleClick"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,10,10" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="170" Height="128" CornerRadius="8" BorderThickness="1" ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#22000000" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <ui:SymbolIcon
                                                Symbol="{Binding Kind, Converter={StaticResource MediaIcon}}"
                                                FontSize="34"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            <Border VerticalAlignment="Bottom" Background="#B3000000" Padding="8,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="{Binding DisplayName}"
                                                        Foreground="White"
                                                        FontSize="12.5"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding KindText}"
                                                        Foreground="#CCFFFFFF"
                                                        FontSize="10.5"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ui:Button
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,3,3,0"
                                                Padding="5"
                                                Appearance="Transparent"
                                                Foreground="White"
                                                ToolTip="从本次列表移除"
                                                Command="{Binding DataContext.RemovePlaylistItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!--  最近播放  -->
                <Border
                    Grid.Row="2"
                    Margin="0,28,0,0"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="20,15,12,10">
                            <TextBlock Text="最近打开" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button
                                HorizontalAlignment="Right"
                                Content="清空记录"
                                Icon="{ui:SymbolIcon Broom24}"
                                Appearance="Transparent"
                                Command="{Binding ClearRecentCommand}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="RecentList"
                                ItemsSource="{Binding Recent}"
                                BorderThickness="0"
                                Background="Transparent"
                                MouseDoubleClick="OnRecentDoubleClick"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="14,10" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon
                                                Grid.Column="0"
                                                Symbol="{Binding Kind, Converter={StaticResource RecentIcon}}"
                                                FontSize="20"
                                                VerticalAlignment="Center"
                                                Margin="2,0,14,0"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{Binding DirectoryName}"
                                                    FontSize="11.5"
                                                    Margin="0,2,0,0"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding ResumeText}"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Margin="10,0,10,0"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:Button
                                                Grid.Column="3"
                                                Appearance="Transparent"
                                                Icon="{ui:SymbolIcon Play24}"
                                                ToolTip="播放"
                                                Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" />
                                            <ui:Button
                                                Grid.Column="4"
                                                Appearance="Transparent"
                                                Icon="{ui:SymbolIcon Dismiss24}"
                                                ToolTip="从记录中移除"
                                                Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=RecentList, Path=HasItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Symbol="History24" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock
                                    Text="暂无打开记录 · 也可以直接把 .msv / .msp 文件拖入窗口"
                                    FontSize="13"
                                    Margin="0,10,0,0"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>            <!--  ============ 设置面板 ============  -->
            <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <Border
                    Width="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Padding="30,26"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="记住播放进度" FontSize="14" />
                                <TextBlock Text="再次打开同一视频时，从上次的位置继续播放" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding RememberPosition}" OnContent="开" OffContent="关" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="记录最近打开" FontSize="14" />
                                <TextBlock Text="在首页显示最近打开过的加密文件（仅保存文件路径）" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding TrackRecent}" OnContent="开" OffContent="关" />
                        </Grid>


                        <Border Height="1" Margin="0,22,0,16" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="密影播放器 1.0.0 · 解密数据仅在内存中处理，密码与密钥不会被保存" />
                            <ui:Button HorizontalAlignment="Right" Content="返回" Command="{Binding ToggleSettingsCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ============ 解锁面板 ============  -->
            <Grid Visibility="{Binding IsUnlockVisible, Converter={StaticResource BoolToVis}}">
                <Border
                    Width="470"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Padding="30,28"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="LockShield24" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding UnlockTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" />
                        <TextBlock
                            Text="{Binding CurrentFileName}"
                            FontSize="13"
                            HorizontalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="390"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{Binding FileSizeText}"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            Margin="0,3,0,0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:PasswordBox
                            x:Name="UnlockPasswordBox"
                            Margin="0,18,0,0"
                            Password="{Binding UnlockPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="密码"
                            RevealButtonEnabled="True"
                            MaxLength="128"
                            KeyDown="OnPasswordKeyDown" />
                        <TextBlock
                            x:Name="CapsLockHint"
                            Text="提示：大写锁定（Caps Lock）已开启"
                            FontSize="12"
                            Margin="2,8,0,0"
                            Visibility="Collapsed"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock
                            Text="{Binding UnlockError}"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Margin="2,10,0,0"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Visibility="{Binding UnlockError, Converter={StaticResource EmptyToCollapsed}}" />
                        <CheckBox Content="记住密码（仅本次运行，退出后自动清除）" IsChecked="{Binding RememberSessionPassword}" Margin="0,14,0,0" />
                        <Grid Margin="0,20,0,0">
                            <TextBlock
                                Text="密码遗忘后无法恢复，请谨慎保存。"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="取消" Command="{Binding CancelUnlockCommand}" />
                                <ui:Button
                                    Content="{Binding UnlockButtonText}"
                                    Icon="{ui:SymbolIcon Play24}"
                                    Appearance="Primary"
                                    Margin="10,0,0,0"
                                    Command="{Binding UnlockCommand}"
                                    IsEnabled="{Binding IsUnlockBusy, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </Grid>
                        <ui:ProgressRing
                            IsIndeterminate="True"
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Visibility="{Binding IsUnlockBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Grid>            <!--  ============ 播放界面 ============  -->
            <vlc:VideoView
                x:Name="PlayerView"
                MediaPlayer="{Binding MediaPlayer}"
                Visibility="Collapsed">
                <Grid x:Name="OverlayRoot" Background="Transparent" MouseMove="OnOverlayMouseMove" MouseLeftButtonDown="OnOverlayMouseLeftButtonDown">
                    <!--  保持极小透明背景，避免控制栏隐藏后视频层完全穿透，鼠标移动无法再次唤出控制栏  -->
                    <Border
                        x:Name="OverlayHitLayer"
                        Background="#01000000" />

                    <!--  顶部栏  -->
                    <Border x:Name="OverlayTop" VerticalAlignment="Top" Padding="16,12,16,34" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#B3000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Appearance="Transparent" Foreground="White" ToolTip="返回文件列表（Esc / Backspace）" Command="{Binding CloseMediaCommand}">
                                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="17" />
                                </ui:Button>
                                <ui:Button Appearance="Transparent" Foreground="White" ToolTip="锁定（停止播放并隐藏画面）" Command="{Binding LockCommand}">
                                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="16" />
                                </ui:Button>
                                <TextBlock
                                    Text="{Binding CurrentFileName}"
                                    Foreground="White"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    MaxWidth="620"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Appearance="Transparent" Foreground="White" ToolTip="窗口置顶" Command="{Binding ToggleTopmostCommand}">
                                    <ui:SymbolIcon Symbol="Pin24" FontSize="15" />
                                </ui:Button>
                                <ui:Button Appearance="Transparent" Foreground="White" ToolTip="关闭视频" Command="{Binding CloseMediaCommand}">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  继续播放提示  -->
                    <Border
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,74,0,0"
                        CornerRadius="8"
                        Padding="14,8"
                        Background="#E61F1F1F"
                        BorderThickness="1"
                        BorderBrush="#33FFFFFF"
                        Visibility="{Binding IsResumeNoticeVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ResumeNoticeText}" Foreground="White" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <ui:Button
                                Content="从头播放"
                                Appearance="Transparent"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Padding="10,5"
                                Margin="14,0,0,0"
                                Command="{Binding RestartFromBeginningCommand}" />
                        </StackPanel>
                    </Border>

                    <!--  中央播放按钮  -->
                    <ui:Button
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="86"
                        Height="86"
                        CornerRadius="43"
                        Appearance="Primary"
                        Opacity="0.96"
                        Visibility="{Binding IsPausedOverlayVisible, Converter={StaticResource BoolToVis}}"
                        Command="{Binding TogglePlayPauseCommand}">
                        <ui:SymbolIcon Symbol="{Binding IsEnded, Converter={StaticResource EndedIcon}}" FontSize="32" />
                    </ui:Button>

                    <!--  底部控制栏  -->
                    <StackPanel VerticalAlignment="Bottom">
                        <Grid HorizontalAlignment="Right" Margin="0,0,24,10">
                            <Border
                                CornerRadius="8"
                                Padding="6"
                                Background="#E61F1F1F"
                                BorderThickness="1"
                                BorderBrush="#33FFFFFF"
                                Visibility="{Binding IsSpeedMenuOpen, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding SpeedOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button
                                                Appearance="Transparent"
                                                Foreground="White"
                                                Padding="12,7"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.SetRateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Margin="0,0,8,0" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Label}" Width="52" />
                                                </StackPanel>
                                            </ui:Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Border
                                CornerRadius="8"
                                Padding="6"
                                Background="#E61F1F1F"
                                BorderThickness="1"
                                BorderBrush="#33FFFFFF"
                                Visibility="{Binding IsAudioMenuOpen, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding AudioTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button
                                                Appearance="Transparent"
                                                Foreground="White"
                                                Padding="12,7"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.SelectAudioTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Margin="0,0,8,0" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Name}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </ui:Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Border
                                CornerRadius="8"
                                Padding="6"
                                Background="#E61F1F1F"
                                BorderThickness="1"
                                BorderBrush="#33FFFFFF"
                                Visibility="{Binding IsSubtitleMenuOpen, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Button
                                                    Appearance="Transparent"
                                                    Foreground="White"
                                                    Padding="12,7"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding DataContext.SelectSubtitleTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Margin="0,0,8,0" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Name}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ui:Button
                                        Content="加载字幕文件…"
                                        Icon="{ui:SymbolIcon Document24}"
                                        Appearance="Transparent"
                                        Foreground="White"
                                        Padding="12,7"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding LoadSubtitleFileCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="OverlayBottom" Padding="22,30,22,14" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#99000000" Offset="0.5" />
                                    <GradientStop Color="#CC000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <Slider
                                    x:Name="PositionSlider"
                                    Minimum="0"
                                    Maximum="{Binding DurationMs}"
                                    Value="{Binding PositionMs, Mode=OneWay}"
                                    IsMoveToPointEnabled="True"
                                    IsTabStop="False"
                                    Focusable="False"
                                    Margin="2,0,2,4"
                                    PreviewMouseLeftButtonDown="OnSeekSliderPreviewMouseDown"
                                    PreviewMouseLeftButtonUp="OnSeekSliderPreviewMouseUp" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Transparent" Foreground="White" ToolTip="后退 5 秒" Command="{Binding SkipBackwardCommand}">
                                            <ui:SymbolIcon Symbol="Rewind24" FontSize="18" />
                                        </ui:Button>
                                        <ui:Button Appearance="Transparent" Foreground="White" Padding="10,7" Margin="4,0" ToolTip="播放 / 暂停（空格）" Command="{Binding TogglePlayPauseCommand}">
                                            <ui:SymbolIcon Symbol="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}" FontSize="21" />
                                        </ui:Button>
                                        <ui:Button Appearance="Transparent" Foreground="White" ToolTip="前进 5 秒" Command="{Binding SkipForwardCommand}">
                                            <ui:SymbolIcon Symbol="FastForward24" FontSize="18" />
                                        </ui:Button>
                                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13" FontFamily="Consolas" Foreground="#E6FFFFFF">
                                            <Run Text="{Binding PositionMs, Converter={StaticResource TimeMs}, Mode=OneWay}" />
                                            <Run Text=" / " />
                                            <Run Text="{Binding DurationMs, Converter={StaticResource TimeMs}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Transparent" Foreground="White" Padding="10,7" ToolTip="播放速度" Content="{Binding CurrentRateText}" Command="{Binding ToggleSpeedMenuCommand}" />
                                        <ui:Button Appearance="Transparent" Foreground="White" ToolTip="音轨" Command="{Binding ToggleAudioMenuCommand}">
                                            <ui:SymbolIcon Symbol="MusicNote124" FontSize="17" />
                                        </ui:Button>
                                        <ui:Button Appearance="Transparent" Foreground="White" ToolTip="字幕" Command="{Binding ToggleSubtitleMenuCommand}">
                                            <ui:SymbolIcon Symbol="Subtitles24" FontSize="17" />
                                        </ui:Button>
                                        <ui:Button Appearance="Transparent" Foreground="White" ToolTip="静音（M）" Command="{Binding ToggleMuteCommand}">
                                            <ui:SymbolIcon Symbol="{Binding Volume, Converter={StaticResource VolumeIcon}}" FontSize="17" />
                                        </ui:Button>
                                        <Slider
                                            x:Name="VolumeSlider"
                                            Width="92"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding Volume}"
                                            VerticalAlignment="Center"
                                            Margin="4,0,10,0"
                                            IsTabStop="False"
                                            Focusable="False" />
                                        <ui:Button Appearance="Transparent" Foreground="White" ToolTip="全屏（F）" Click="OnFullscreenButtonClick">
                                            <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="17" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </vlc:VideoView>

            <!--  ============ 照片查看 ============  -->
            <Grid
                Background="#0B0B0C"
                Visibility="{Binding IsViewingPhoto, Converter={StaticResource BoolToVis}}"
                MouseMove="OnOverlayMouseMove">
                <myui:PhotoPreviewControl x:Name="PhotoViewer" Source="{Binding PhotoSource}" />

                <!--  照片顶部栏  -->
                <Border x:Name="PhotoOverlayTop" VerticalAlignment="Top" Padding="16,12,16,34" Opacity="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B3000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="Transparent" Foreground="White" ToolTip="返回文件列表（Esc / Backspace）" Command="{Binding CloseMediaCommand}">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="17" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Foreground="White" ToolTip="锁定（隐藏画面）" Command="{Binding LockCommand}">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="16" />
                            </ui:Button>
                            <TextBlock
                                Text="{Binding CurrentFileName}"
                                Foreground="White"
                                FontSize="14"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                MaxWidth="620"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Appearance="Transparent" Foreground="White" ToolTip="窗口置顶" Command="{Binding ToggleTopmostCommand}">
                                <ui:SymbolIcon Symbol="Pin24" FontSize="15" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Foreground="White" ToolTip="关闭照片" Command="{Binding CloseMediaCommand}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  照片底部栏  -->
                <Border x:Name="PhotoOverlayBottom" VerticalAlignment="Bottom" Padding="22,30,22,14" Opacity="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#99000000" Offset="0.5" />
                            <GradientStop Color="#CC000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding PhotoInfoText}"
                            Foreground="#E6FFFFFF"
                            FontSize="13"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Appearance="Transparent" Foreground="White" Content="上一张" ToolTip="上一张（←）" Command="{Binding PlayPreviousCommand}" IsEnabled="{Binding HasPrevious}" />
                            <ui:Button Appearance="Transparent" Foreground="White" Content="下一张" ToolTip="下一张（→）" Command="{Binding PlayNextCommand}" IsEnabled="{Binding HasNext}" />
                            <ui:Button Appearance="Transparent" Foreground="White" ToolTip="缩小（-）" Click="OnPhotoZoomOutClick">
                                <ui:SymbolIcon Symbol="ZoomOut24" FontSize="17" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Foreground="White" ToolTip="放大（+）" Click="OnPhotoZoomInClick">
                                <ui:SymbolIcon Symbol="ZoomIn24" FontSize="17" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Foreground="White" Content="适应" ToolTip="适应窗口（0 / 双击画面）" Click="OnPhotoFitClick" />
                            <ui:Button Appearance="Transparent" Foreground="White" Content="100%" ToolTip="原始大小（1）" Click="OnPhotoActualSizeClick" />
                            <ui:Button Appearance="Transparent" Foreground="White" ToolTip="旋转（R）" Click="OnPhotoRotateClick">
                                <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="17" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Foreground="White" ToolTip="全屏（F）" Click="OnFullscreenButtonClick">
                                <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="17" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>