<ui:FluentWindow
    x:Class="MiYing.Encryptor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:MiYing.Encryptor.Converters"
    xmlns:vm="clr-namespace:MiYing.Encryptor.ViewModels"
    Title="密影 · 加密工具"
    Width="1180" Height="840"
    MinWidth="1000" MinHeight="720"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    AllowDrop="True"
    DragOver="OnWindowDragOver"
    Drop="OnWindowDrop"
    Closing="OnWindowClosing">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:FileIconConverter x:Key="FileIcon" />
        <conv:ModeIconConverter x:Key="ModeIcon" />
        <conv:ScoreSegmentBrushConverter x:Key="ScoreBrush" />

        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentRoot" CornerRadius="7" Background="Transparent" Padding="20,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentRoot" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentRoot" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Grid Grid.Row="0">
            <ui:TitleBar Title="密影 · 加密工具" ShowMaximize="True" ShowMinimize="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,150,0">
                <ui:Button x:Name="ThemeButton" Appearance="Transparent" Padding="8,7" Click="OnThemeButtonClick">
                    <ui:SymbolIcon x:Name="ThemeIcon" Symbol="Desktop24" FontSize="15" />
                </ui:Button>
            </StackPanel>
        </Grid>

        <!--  主体  -->
        <Grid Grid.Row="1" Margin="28,6,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="190" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题 + 模式切换  -->
            <Grid Grid.Row="0" Margin="0,6,0,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModeTitle}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock
                        Text="{Binding ModeDescription}"
                        FontSize="13"
                        Margin="0,5,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Padding="3"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            GroupName="WorkMode"
                            Content="视频加密"
                            Style="{StaticResource SegmentButtonStyle}"
                            IsChecked="{Binding IsVideoMode, Mode=OneWay}"
                            Command="{Binding SwitchModeCommand}"
                            CommandParameter="Encrypt" />
                        <RadioButton
                            GroupName="WorkMode"
                            Content="照片加密"
                            Style="{StaticResource SegmentButtonStyle}"
                            IsChecked="{Binding IsPhotoMode, Mode=OneWay}"
                            Command="{Binding SwitchModeCommand}"
                            CommandParameter="PhotoEncrypt" />
                        <RadioButton
                            GroupName="WorkMode"
                            Content="解密还原"
                            Style="{StaticResource SegmentButtonStyle}"
                            IsChecked="{Binding IsDecryptMode, Mode=OneWay}"
                            Command="{Binding SwitchModeCommand}"
                            CommandParameter="Decrypt" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  结果提示  -->
            <ui:InfoBar
                Grid.Row="1"
                Margin="0,0,0,12"
                Title="处理结果"
                Message="{Binding SummaryMessage}"
                Severity="{Binding SummarySeverity}"
                IsOpen="{Binding IsSummaryOpen, Mode=TwoWay}"
                IsClosable="True" />

            <!--  工具条  -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:Button Content="{Binding AddFilesButtonText}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddFilesCommand}" />
                <ui:Button Content="添加文件夹" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" Command="{Binding AddFolderCommand}" />
                <ui:Button
                    Content="全选"
                    Icon="{ui:SymbolIcon Checkmark24}"
                    Appearance="Transparent"
                    Margin="8,0,0,0"
                    Visibility="{Binding IsPhotoMode, Converter={StaticResource BoolToVis}}"
                    IsEnabled="{Binding HasFiles}"
                    Command="{Binding SelectAllPhotosCommand}" />
                <ui:Button
                    Content="反选"
                    Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                    Appearance="Transparent"
                    Margin="4,0,0,0"
                    Visibility="{Binding IsPhotoMode, Converter={StaticResource BoolToVis}}"
                    IsEnabled="{Binding HasFiles}"
                    Command="{Binding InvertPhotoSelectionCommand}" />
                <ui:Button
                    Content="清空列表"
                    Icon="{ui:SymbolIcon Broom24}"
                    Appearance="Transparent"
                    Margin="8,0,0,0"
                    IsEnabled="{Binding HasFiles}"
                    Command="{Binding ClearFilesCommand}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Margin="14,0,0,0"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}"
                    Text="{Binding Files.Count, StringFormat={}共 {0} 个文件}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Margin="14,0,0,0"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Visibility="{Binding IsPhotoMode, Converter={StaticResource BoolToVis}}"
                    Text="{Binding PhotoSelectionText}" />
            </StackPanel>

            <!--  文件列表  -->
            <Border
                Grid.Row="3"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}">
                    <ListView
                        x:Name="FileList"
                        ItemsSource="{Binding Files}"
                        BorderThickness="0"
                        Background="Transparent"
                        SelectionMode="Single"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,9" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        Symbol="{Binding FileName, Converter={StaticResource FileIcon}}"
                                        FontSize="22"
                                        VerticalAlignment="Center"
                                        Margin="4,0,14,0"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{Binding DirectoryName}"
                                            FontSize="11.5"
                                            Margin="0,2,0,0"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ProgressBar
                                            Maximum="1"
                                            Value="{Binding Progress}"
                                            Height="3"
                                            Margin="0,7,26,1"
                                            BorderThickness="0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Working">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                        <TextBlock
                                            Text="{Binding ErrorMessage}"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Margin="0,4,20,0"
                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding FileSizeText}"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Margin="10,0,14,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Border Grid.Column="3" CornerRadius="6" Padding="9,3" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Working">
                                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Working">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <ui:Button
                                        Grid.Column="4"
                                        Appearance="Transparent"
                                        Padding="6"
                                        ToolTip="移除"
                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                    </ui:Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--  空状态  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding NoFiles, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="VideoClip24" FontSize="42" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding EmptyStateTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="{Binding EmptyStateDescription}"
                            FontSize="12"
                            Margin="0,6,0,16"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="{Binding AddFilesButtonText}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Command="{Binding AddFilesCommand}" />
                            <ui:Button Content="添加文件夹" Icon="{ui:SymbolIcon FolderOpen24}" Margin="10,0,0,0" Command="{Binding AddFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                    </Grid>

                    <!--  照片缩略图网格  -->
                    <Grid Visibility="{Binding IsPhotoMode, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                        <Border
                                            Width="190"
                                            Height="190"
                                            Margin="6"
                                            CornerRadius="10"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            ClipToBounds="True">
                                            <Grid>
                                                <ui:SymbolIcon
                                                    Symbol="Image24"
                                                    FontSize="34"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Image
                                                    Source="{Binding Thumbnail}"
                                                    Stretch="Uniform"
                                                    Margin="8,8,8,38"
                                                    MouseLeftButtonDown="OnPhotoImageMouseDown" />
                                                <CheckBox
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="8" />
                                                <ui:Button
                                                    Appearance="Transparent"
                                                    Padding="4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="2"
                                                    ToolTip="移除"
                                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" />
                                                </ui:Button>
                                                <ProgressBar
                                                    Maximum="1"
                                                    Value="{Binding Progress}"
                                                    Height="3"
                                                    VerticalAlignment="Bottom"
                                                    Margin="8,0,8,34"
                                                    BorderThickness="0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Working">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <Border
                                                    VerticalAlignment="Bottom"
                                                    Background="#D9000000"
                                                    Padding="8,5"
                                                    CornerRadius="0,0,9,9">
                                                    <StackPanel>
                                                        <TextBlock
                                                            Text="{Binding FileName}"
                                                            FontSize="12"
                                                            Foreground="White"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding FileSizeText}" FontSize="11" Foreground="#CCFFFFFF" />
                                                            <TextBlock
                                                                Text="{Binding StatusText}"
                                                                FontSize="11"
                                                                Margin="8,0,0,0"
                                                                Foreground="#CCFFFFFF"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding NoFiles, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="Image24" FontSize="42" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="拖拽照片到此处" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center" />
                            <TextBlock
                                Text="支持 JPG / PNG / WebP / HEIC / TIFF 等格式，可添加整个文件夹"
                                FontSize="12"
                                Margin="0,6,0,16"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:Button Content="添加照片" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Command="{Binding AddFilesCommand}" />
                                <ui:Button Content="添加文件夹" Icon="{ui:SymbolIcon FolderOpen24}" Margin="10,0,0,0" Command="{Binding AddFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!--  选项卡片  -->
            <Border
                Grid.Row="4"
                Margin="0,16,0,16"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  密码  -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock Text="密码" FontSize="13" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:PasswordBox
                                Width="228"
                                Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="请输入密码（至少 8 位）"
                                RevealButtonEnabled="True"
                                MaxLength="128" />
                            <ui:PasswordBox
                                Width="200"
                                Margin="12,0,0,0"
                                Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="再次输入确认"
                                RevealButtonEnabled="True"
                                MaxLength="128"
                                Visibility="{Binding IsEncryptMode, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                            <Border Width="44" Height="4" CornerRadius="2" Margin="0,0,5,0" Background="{Binding PasswordScore, Converter={StaticResource ScoreBrush}, ConverterParameter=0}" />
                            <Border Width="44" Height="4" CornerRadius="2" Margin="0,0,5,0" Background="{Binding PasswordScore, Converter={StaticResource ScoreBrush}, ConverterParameter=1}" />
                            <Border Width="44" Height="4" CornerRadius="2" Margin="0,0,5,0" Background="{Binding PasswordScore, Converter={StaticResource ScoreBrush}, ConverterParameter=2}" />
                            <Border Width="44" Height="4" CornerRadius="2" Background="{Binding PasswordScore, Converter={StaticResource ScoreBrush}, ConverterParameter=3}" />
                            <TextBlock
                                Text="{Binding PasswordScoreText}"
                                VerticalAlignment="Center"
                                Margin="10,-1,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            Text="提示：密码遗忘后无法找回，也无法还原文件，请务必牢记。"
                            FontSize="12"
                            Margin="2,10,0,0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Margin="24,2" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <!--  设置  -->
                    <StackPanel Grid.Column="2" MinWidth="340" VerticalAlignment="Top">
                        <StackPanel
                            Orientation="Horizontal"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsEncryptMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="加密强度" FontSize="13" VerticalAlignment="Center" />
                            <ComboBox Width="216" Margin="12,0,0,0" SelectedIndex="{Binding StrengthIndex}">
                                <ComboBoxItem Content="标准（推荐）" />
                                <ComboBoxItem Content="增强（更慢、更安全）" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox
                            Content="加密后校验文件完整性（推荐）"
                            Margin="0,0,0,10"
                            IsChecked="{Binding VerifyAfterEncrypt}"
                            Visibility="{Binding IsEncryptMode, Converter={StaticResource BoolToVis}}" />
                        <CheckBox
                            Content="完成后将原文件移入回收站"
                            Margin="0,0,0,10"
                            IsChecked="{Binding DeleteOriginalAfter}"
                            Checked="OnDeleteOriginalChecked" />
                        <CheckBox Content="输出到指定文件夹" IsChecked="{Binding UseCustomOutputFolder}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Margin="0,10,0,0"
                            Visibility="{Binding UseCustomOutputFolder, Converter={StaticResource BoolToVis}}">
                            <ui:TextBox
                                Width="228"
                                IsReadOnly="True"
                                Text="{Binding OutputFolder, Mode=OneWay}"
                                PlaceholderText="尚未选择输出文件夹" />
                            <ui:Button Content="浏览…" Icon="{ui:SymbolIcon Folder24}" Margin="8,0,0,0" Command="{Binding BrowseOutputFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  底部操作栏  -->
        <Border
            Grid.Row="2"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Padding="28,14,28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverallText}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ProgressBar Maximum="1" Value="{Binding OverallProgress}" Height="4" Margin="0,8,36,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button
                        Content="取消"
                        Appearance="Secondary"
                        Margin="0,0,10,0"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <ui:Button
                        Content="{Binding StartButtonText}"
                        Icon="{Binding Mode, Converter={StaticResource ModeIcon}}"
                        Appearance="Primary"
                        FontWeight="SemiBold"
                        Padding="26,11"
                        Command="{Binding StartCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>