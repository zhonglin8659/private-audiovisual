<ui:FluentWindow
    x:Class="MiYing.Encryptor.Views.PhotoPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:myui="clr-namespace:MiYing.UI;assembly=MiYing.UI"
    Title="照片预览"
    Width="1080"
    Height="760"
    MinWidth="640"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="None"
    ExtendsContentIntoTitleBar="True"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="照片预览" ShowMaximize="True" ShowMinimize="True" />

        <Grid Grid.Row="1" Background="#0B0B0C">
            <myui:PhotoPreviewControl x:Name="Viewer" />
            <ui:ProgressRing
                x:Name="LoadingRing"
                IsIndeterminate="True"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <Border
                x:Name="ErrorPanel"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24,18"
                CornerRadius="10"
                Background="#E61F1F1F"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="White"
                    FontSize="13"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="16,10"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <TextBlock
                    x:Name="InfoText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="－" ToolTip="缩小（-）" Padding="12,6" Click="OnZoomOutClick" />
                    <ui:Button Content="＋" ToolTip="放大（+）" Padding="12,6" Margin="6,0,0,0" Click="OnZoomInClick" />
                    <ui:Button Content="适应窗口" ToolTip="适应窗口（0 / 双击画面）" Margin="6,0,0,0" Click="OnFitClick" />
                    <ui:Button Content="100%" ToolTip="原始大小（1）" Margin="6,0,0,0" Click="OnActualSizeClick" />
                    <ui:Button Content="旋转" ToolTip="顺时针旋转（R）" Margin="6,0,0,0" Click="OnRotateClick" />
                    <ui:Button Content="关闭" Margin="6,0,0,0" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>