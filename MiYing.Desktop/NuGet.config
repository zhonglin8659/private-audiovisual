<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 本地离线包目录（包含体积较大的 VLC 运行时包，避免大文件反复下载失败） -->
    <add key="local" value=".nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>